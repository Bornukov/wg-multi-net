# ============================================================
# wg-multi-net — конфигурация
# Скопируйте в .env и заполните своими значениями:
#   cp config/.env.example config/.env
# ============================================================

# --- Админ wg-access-server ---
WG_ADMIN_PASSWORD=CHANGE_ME_STRONG_PASSWORD
WG_WIREGUARD_PRIVATE_KEY=

# --- Сервер ---
SERVER_IP=CHANGE_ME_YOUR_IP
WG_IMAGE=ghcr.io/freifunkmuc/wg-access-server:latest

# --- Домены ---
PORTAL_DOMAIN=vpn1.example.com
NET1_DOMAIN=net1.vpn1.example.com
NET2_DOMAIN=net2.vpn1.example.com
NET3_DOMAIN=net3.vpn1.example.com
NET4_DOMAIN=net4.vpn1.example.com

# --- SSL-сертификат ---
SSL_CERT=/etc/nginx/ssl/example.com/full.crt
SSL_KEY=/etc/nginx/ssl/example.com/key

# --- NetAngels API (для автообновления сертификата) ---
NETANGELS_API_KEY=CHANGE_ME
NETANGELS_DOMAIN=*.example.com
NETANGELS_TARGET_DIR=/etc/nginx/ssl/example.com
